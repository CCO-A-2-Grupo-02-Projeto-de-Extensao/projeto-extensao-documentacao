          "format": "table",
          "rawSql": "SELECT * FROM (\n  SELECT 'Pessoa' AS Tabela, COUNT(*) AS Registros FROM Pessoa\n  UNION ALL SELECT 'Presença', COUNT(*) FROM presenca\n  UNION ALL SELECT 'Chamada', COUNT(*) FROM chamada\n  UNION ALL SELECT 'Evento', COUNT(*) FROM evento\n  UNION ALL SELECT 'Documento', COUNT(*) FROM Documento\n  UNION ALL SELECT 'Especialidade concluída', COUNT(*) FROM Especialidade_concluida\n  UNION ALL SELECT 'Ficha médica', COUNT(*) FROM Ficha_medica\n  UNION ALL SELECT 'Medicação', COUNT(*) FROM Medicacao\n  UNION ALL SELECT 'Ocorrência', COUNT(*) FROM Ocorrencia\n  UNION ALL SELECT 'Usuário', COUNT(*) FROM Usuario\n) t ORDER BY Registros DESC"
