          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 'Chamadas sem nenhuma presença registrada' AS Verificação, COUNT(*) AS Ocorrências\nFROM chamada c WHERE NOT EXISTS (SELECT 1 FROM presenca pr WHERE pr.Chamada_idChamada = c.idChamada)\nUNION ALL SELECT 'Mais de uma chamada no mesmo dia', COUNT(*) FROM (\n  SELECT data_chamada FROM chamada GROUP BY data_chamada HAVING COUNT(*) > 1) t\nUNION ALL SELECT 'Eventos repetidos (mesmo nome, tipo e data)', COALESCE(SUM(n - 1), 0) FROM (\n  SELECT COUNT(*) AS n FROM evento GROUP BY nome, tipo, data_inicio HAVING COUNT(*) > 1) t\nUNION ALL SELECT 'Presenças de pessoas desativadas', COUNT(*)\nFROM presenca pr JOIN Pessoa p ON p.idPessoa = pr.Pessoa_idPessoa WHERE p.ativo = 0\nUNION ALL SELECT 'Documentos sem pessoa', COUNT(*) FROM Documento WHERE Pessoa_idPessoa IS NULL"
        }
