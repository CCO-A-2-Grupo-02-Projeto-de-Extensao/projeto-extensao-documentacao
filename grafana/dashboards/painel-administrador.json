    {
      "type": "table",
      "title": "Cadastros incompletos (desbravadores ativos)",
      "id": 16,
      "datasource": {
        "type": "mysql",
        "uid": "arandu-mysql"
      },
      "description": "",
      "gridPos": {
        "x": 0,
