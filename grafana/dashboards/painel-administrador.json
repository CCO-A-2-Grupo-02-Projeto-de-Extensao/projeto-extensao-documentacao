      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "arandu-mysql"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT 'Sem unidade' AS Problema, COUNT(*) AS Quantidade FROM Pessoa p\nJOIN Cargo cg ON cg.idCargo = p.fkCargo AND cg.Nome = 'Desbravador'\nWHERE p.ativo = 1 AND p.Unidade_idUnidade IS NULL\nUNION ALL SELECT 'Sem classe', COUNT(*) FROM Pessoa p\nJOIN Cargo cg ON cg.idCargo = p.fkCargo AND cg.Nome = 'Desbravador'\nWHERE p.ativo = 1 AND p.Classe_idClasse IS NULL\nUNION ALL SELECT 'Sem gênero', COUNT(*) FROM Pessoa p\nJOIN Cargo cg ON cg.idCargo = p.fkCargo AND cg.Nome = 'Desbravador'\nWHERE p.ativo = 1 AND p.Genero_idGenero IS NULL\nUNION ALL SELECT 'Sem data de nascimento', COUNT(*) FROM Pessoa p\nJOIN Cargo cg ON cg.idCargo = p.fkCargo AND cg.Nome = 'Desbravador'\nWHERE p.ativo = 1 AND (p.data_nascimento IS NULL OR p.data_nascimento = '')\nUNION ALL SELECT 'Sem responsável', COUNT(*) FROM Pessoa p\nJOIN Cargo cg ON cg.idCargo = p.fkCargo AND cg.Nome = 'Desbravador'\nWHERE p.ativo = 1 AND (p.nome_responsavel1 IS NULL OR p.nome_responsavel1 = '')\nUNION ALL SELECT 'Sem consentimento LGPD', COUNT(*) FROM Pessoa p\nJOIN Cargo cg ON cg.idCargo = p.fkCargo AND cg.Nome = 'Desbravador'\nWHERE p.ativo = 1 AND p.consentimento_em IS NULL"
        }
      ],
