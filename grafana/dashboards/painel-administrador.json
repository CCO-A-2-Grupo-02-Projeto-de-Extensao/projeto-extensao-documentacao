          "rawSql": "SELECT STR_TO_DATE(DATE_FORMAT(dia, '%Y-%m-01'), '%Y-%m-%d') AS time,\n  100 * AVG(chuva_mm IS NOT NULL) AS `Dias com chuva medida`,\n  100 * AVG(temp_media_c IS NOT NULL) AS `Dias com temperatura`\nFROM arandu_analise.fatores_dia WHERE $__timeFilter(dia)\nGROUP BY 1 ORDER BY 1"
