    {
      "type": "table",
      "title": "Cobertura por fonte",
      "id": 6,
      "datasource": {
        "type": "mysql",
        "uid": "arandu-mysql"
      },
      "description": "Cobertura = dias com dado ÷ dias do recorte. Nas chamadas (lidas ao vivo do sistema), ÷ semanas entre a primeira e a última. Atraso = dias desde o último dado.",
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 14,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "arandu-mysql"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT fonte AS Fonte, DATE_FORMAT(primeiro_dia, '%d/%m/%Y') AS `Primeiro dia`, DATE_FORMAT(ultimo_dia, '%d/%m/%Y') AS `Último dia`,\n  dias_com_dado AS `Dias com dado`, cobertura_pct AS Cobertura, GREATEST(0, DATEDIFF(CURDATE(), ultimo_dia)) AS `Atraso (dias)`\nFROM arandu_analise.cobertura_fontes WHERE fonte <> 'chamadas'\nUNION ALL\nSELECT 'chamadas', DATE_FORMAT(MIN(data_chamada), '%d/%m/%Y'), DATE_FORMAT(MAX(data_chamada), '%d/%m/%Y'), COUNT(DISTINCT data_chamada),\n  LEAST(100, ROUND(100 * COUNT(DISTINCT data_chamada) / (DATEDIFF(MAX(data_chamada), MIN(data_chamada)) / 7 + 1), 1)),\n  DATEDIFF(CURDATE(), MAX(data_chamada))\nFROM chamada"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Cobertura"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "max",
                "value": 100
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "basic"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#b33a4a"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Fonte"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
