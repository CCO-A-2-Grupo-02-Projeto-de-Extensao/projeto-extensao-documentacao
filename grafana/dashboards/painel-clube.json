          "rawSql": "SELECT 6 * COUNT(*) - (SELECT COUNT(DISTINCT d.Pessoa_idPessoa, d.tipo) FROM Documento d\nJOIN Pessoa p ON p.idPessoa = d.Pessoa_idPessoa JOIN Cargo cg ON cg.idCargo = p.fkCargo AND cg.Nome = 'Desbravador'\nWHERE p.ativo = 1 AND d.tipo IN ('certidaoNascimento','cartaoSus','carteiraVacinacao','carteiraConvenio','comprovanteEndereco','autorizacaoClube'))\nFROM Pessoa p\nJOIN Cargo cg ON cg.idCargo = p.fkCargo AND cg.Nome = 'Desbravador'\nWHERE p.ativo = 1"
