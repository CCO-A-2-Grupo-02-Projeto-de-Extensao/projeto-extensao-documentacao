    {
      "type": "barchart",
      "title": "Documentos obrigatórios entregues",
      "id": 24,
      "datasource": {
        "type": "mysql",
        "uid": "arandu-mysql"
      },
      "description": "Percentual dos desbravadores ativos que já têm cada documento digitalizado.",
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "arandu-mysql"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT CASE t.tipo\n    WHEN 'certidaoNascimento' THEN 'Certidão de Nascimento' WHEN 'cartaoSus' THEN 'Cartão SUS'\n    WHEN 'carteiraVacinacao' THEN 'Carteira de Vacinação' WHEN 'carteiraConvenio' THEN 'Carteira do Convênio'\n    WHEN 'comprovanteEndereco' THEN 'Comprovante de Endereço' ELSE 'Autorização do Clube' END AS Documento,\n  100 * COUNT(DISTINCT d.Pessoa_idPessoa) / (SELECT COUNT(*) FROM Pessoa p\nJOIN Cargo cg ON cg.idCargo = p.fkCargo AND cg.Nome = 'Desbravador'\nWHERE p.ativo = 1) AS Entregues\nFROM (SELECT 'certidaoNascimento' AS tipo UNION ALL SELECT 'cartaoSus' UNION ALL SELECT 'carteiraVacinacao'\n      UNION ALL SELECT 'carteiraConvenio' UNION ALL SELECT 'comprovanteEndereco' UNION ALL SELECT 'autorizacaoClube') t\nLEFT JOIN (SELECT d.Pessoa_idPessoa, d.tipo FROM Documento d JOIN Pessoa p ON p.idPessoa = d.Pessoa_idPessoa\n           JOIN Cargo cg ON cg.idCargo = p.fkCargo AND cg.Nome = 'Desbravador' WHERE p.ativo = 1) d ON d.tipo = t.tipo\nGROUP BY t.tipo ORDER BY Entregues DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds",
            "fixedColor": "#b33a4a"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#e11d48",
                "value": null
              },
              {
                "color": "#d97706",
                "value": 70
              },
              {
                "color": "#10b981",
                "value": 85
              }
            ]
          },
          "max": 100,
          "min": 0
        },
        "overrides": []
