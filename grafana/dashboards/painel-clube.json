    {
      "type": "timeseries",
      "title": "Frequência por reunião × chuva do dia",
      "id": 9,
      "datasource": {
        "type": "mysql",
        "uid": "arandu-mysql"
      },
      "description": "Chuva vem da estação A701 do INMET (base externa). O INMET publica com cerca de um mês de atraso.",
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 16,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "arandu-mysql"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT c.data_chamada AS time, 100 * AVG(pr.presenca) AS `Frequência`\nFROM presenca pr\nJOIN chamada c ON c.idChamada = pr.Chamada_idChamada\nJOIN Pessoa p ON p.idPessoa = pr.Pessoa_idPessoa\nJOIN Cargo cg ON cg.idCargo = p.fkCargo AND cg.Nome = 'Desbravador'\nLEFT JOIN Unidade u ON u.idUnidade = p.Unidade_idUnidade\nLEFT JOIN Classe cl ON cl.idClasse = p.Classe_idClasse\nLEFT JOIN Genero g ON g.idGenero = p.Genero_idGenero\nWHERE $__timeFilter(c.data_chamada)\nGROUP BY c.data_chamada ORDER BY 1"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "mysql",
            "uid": "arandu-mysql"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT f.dia AS time, f.chuva_mm AS `Chuva`\nFROM arandu_analise.fatores_dia f\nWHERE f.dia IN (SELECT c.data_chamada FROM chamada c WHERE $__timeFilter(c.data_chamada))\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "color": {
            "mode": "fixed",
            "fixedColor": "#b33a4a"
          },
