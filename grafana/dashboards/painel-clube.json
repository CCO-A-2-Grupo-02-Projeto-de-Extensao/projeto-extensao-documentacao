    {
      "type": "barchart",
      "title": "Frequência por condição do dia",
      "id": 14,
      "datasource": {
        "type": "mysql",
        "uid": "arandu-mysql"
      },
      "description": "Cruza as chamadas do sistema com a base externa (INMET e ANBIMA).",
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "arandu-mysql"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT condicao AS Condição, 100 * AVG(presenca) AS Frequência FROM (\n  SELECT pr.presenca, CASE\n    WHEN f.feriado_prolongado THEN '1. Feriado prolongado'\n    WHEN f.chuva_mm IS NULL THEN '5. Sem dado de clima'\n    WHEN f.chuva_mm >= 10 THEN '2. Chuva forte (≥ 10 mm)'\n    WHEN f.chuva_mm >= 2 THEN '3. Chuva fraca (2–10 mm)'\n    ELSE '4. Sem chuva' END AS condicao\n  FROM presenca pr\nJOIN chamada c ON c.idChamada = pr.Chamada_idChamada\nJOIN Pessoa p ON p.idPessoa = pr.Pessoa_idPessoa\nJOIN Cargo cg ON cg.idCargo = p.fkCargo AND cg.Nome = 'Desbravador'\nLEFT JOIN Unidade u ON u.idUnidade = p.Unidade_idUnidade\nLEFT JOIN Classe cl ON cl.idClasse = p.Classe_idClasse\nLEFT JOIN Genero g ON g.idGenero = p.Genero_idGenero\nLEFT JOIN arandu_analise.fatores_dia f ON f.dia = c.data_chamada\n  WHERE $__timeFilter(c.data_chamada)\n) t GROUP BY condicao ORDER BY condicao"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "thresholds",
            "fixedColor": "#b33a4a"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#e11d48",
                "value": null
              },
              {
                "color": "#d97706",
                "value": 70
              },
              {
                "color": "#10b981",
                "value": 85
              }
            ]
          },
          "max": 100,
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "showValue": "always",
        "legend": {
          "showLegend": false
        },
        "xTickLabelRotation": 0,
        "barWidth": 0.7
      }
