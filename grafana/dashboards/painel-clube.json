    {
      "type": "table",
      "title": "Atenção: frequência abaixo de 75%",
      "id": 10,
      "datasource": {
        "type": "mysql",
        "uid": "arandu-mysql"
      },
      "description": "Quem mais faltou no período, para o conselheiro procurar a família.",
      "gridPos": {
        "x": 16,
        "y": 6,
        "w": 8,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "arandu-mysql"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT p.nome AS Desbravador, COALESCE(u.nome, '—') AS Unidade,\n  SUM(pr.presenca) AS Presenças, COUNT(*) AS Chamadas, 100 * AVG(pr.presenca) AS Frequência\nFROM presenca pr\nJOIN chamada c ON c.idChamada = pr.Chamada_idChamada\nJOIN Pessoa p ON p.idPessoa = pr.Pessoa_idPessoa\nJOIN Cargo cg ON cg.idCargo = p.fkCargo AND cg.Nome = 'Desbravador'\nLEFT JOIN Unidade u ON u.idUnidade = p.Unidade_idUnidade\nLEFT JOIN Classe cl ON cl.idClasse = p.Classe_idClasse\nLEFT JOIN Genero g ON g.idGenero = p.Genero_idGenero\nWHERE $__timeFilter(c.data_chamada) AND p.ativo = 1\nGROUP BY p.idPessoa, p.nome, u.nome\nHAVING Frequência < 75\nORDER BY Frequência, p.nome"
        }
      ],
