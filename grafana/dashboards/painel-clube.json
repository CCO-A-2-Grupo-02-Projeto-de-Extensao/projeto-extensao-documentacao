    {
      "type": "stat",
      "title": "Perda de frequência",
      "id": 18,
      "datasource": {
        "type": "mysql",
        "uid": "arandu-mysql"
      },
      "description": "Pontos percentuais a menos em relação a um sábado normal, sem chuva e sem feriado.",
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "mysql",
            "uid": "arandu-mysql"
          },
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT\n  100 * AVG(CASE WHEN f.chuva_mm < 2 AND NOT f.feriado_prolongado THEN pr.presenca END)\n  - 100 * AVG(CASE WHEN f.chuva_mm >= 10 THEN pr.presenca END) AS `Com chuva forte`,\n  100 * AVG(CASE WHEN f.chuva_mm < 2 AND NOT f.feriado_prolongado THEN pr.presenca END)\n  - 100 * AVG(CASE WHEN f.feriado_prolongado THEN pr.presenca END) AS `Em feriado prolongado`\nFROM presenca pr\nJOIN chamada c ON c.idChamada = pr.Chamada_idChamada\nJOIN Pessoa p ON p.idPessoa = pr.Pessoa_idPessoa\nJOIN Cargo cg ON cg.idCargo = p.fkCargo AND cg.Nome = 'Desbravador'\nLEFT JOIN Unidade u ON u.idUnidade = p.Unidade_idUnidade\nLEFT JOIN Classe cl ON cl.idClasse = p.Classe_idClasse\nLEFT JOIN Genero g ON g.idGenero = p.Genero_idGenero\nLEFT JOIN arandu_analise.fatores_dia f ON f.dia = c.data_chamada\nWHERE $__timeFilter(c.data_chamada)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 1,
          "color": {
            "mode": "fixed",
            "fixedColor": "#d97706"
          },
